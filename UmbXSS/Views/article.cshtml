@inherits Umbraco.Web.Mvc.UmbracoViewPage<Article>

@using Clean.Core.ViewModels
@using Clean.Core.Extensions

@{
    Layout = "master.cshtml";
}

@Html.Partial("~/Views/Partials/pageHeader.cshtml", new PageHeaderViewModel(Model.Name, Model.Title, Model.Subtitle, Model.MainImage, Model.AuthorName, Model.ArticleDate))

<article>
    @Html.GetGridHtml(Model, "mainContent", "Clean", fluidImages: true)
</article>

<div class="container">
    <div class="row">
        <div class="col-lg-8 col-md-10 mx-auto">
            <hr />
            <h3>Comments</h3>
            @Html.Action("CommentsList", "BlogComments")
        </div>
    </div>
    <div class="row">
        <div class="col-lg-8 col-md-10 mx-auto">
            <h4>Add a comment</h4>
            @Html.Action("CommentForm", "BlogComments")
        </div>
    </div>
</div>